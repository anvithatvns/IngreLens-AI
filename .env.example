# IngreLens AI — Environment Variables
# Copy this file to .env and fill in your values

# ── App ─────────────────────────────────────────
APP_NAME=IngreLens AI
DEBUG=false
LOG_LEVEL=INFO

# ── LLM Providers (optional — free tier works without these) ────
# Set one of these to enable AI-powered chat responses
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=openai          # openai | anthropic
# LLM_MODEL=gpt-4o-mini        # cheapest capable model

# ── Feature Flags ────────────────────────────────
ENABLE_OCR=true
ENABLE_RAG=true
ENABLE_BARCODE=true

# ── Database (for future persistence) ───────────
# DATABASE_URL=postgresql://user:pass@localhost/ingrelens
# REDIS_URL=redis://localhost:6379
